# BLOCK27 — environment template. Copy to .env.local and fill in.
# .env.local is gitignored. Never commit real values.

# --- Supabase (public: safe in the client bundle) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (SECRET: server only, bypasses RLS, never NEXT_PUBLIC) ---
# Used only for privileged setup tasks (e.g. running the RLS test). Not used by
# product code. If this ever appears in the client bundle, treat it as leaked.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- The Brain (Anthropic) ---
# SECRET, server only, never NEXT_PUBLIC. Powers garment analysis (vision).
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model for garment analysis. Haiku-tier matches the ~$0.005/garment cost model;
# bump to a stronger model here for a richer taste read.
ANALYSIS_MODEL=claude-haiku-4-5
# Model for outfit composition (taste). Sonnet-tier matches the ~$0.01–0.02
# compose budget; bump to claude-opus-4-8 for maximum taste.
OUTFIT_MODEL=claude-sonnet-5

# --- Moderation gate (explicit-content check before storage) ---
# Swappable like the render hand. 'anthropic' reuses the vision provider above —
# no new third-party vendor. The gate is server-only and never stored-then-checked.
MODERATION_PROVIDER=anthropic
# Vision model for the gate. Haiku-tier is enough for explicit-content screening.
MODERATION_MODEL=claude-haiku-4-5

# --- The Hand (render provider) ---
# 'stub' renders nothing; 'fashn' is the real virtual try-on provider.
HAND_PROVIDER=fashn
# SECRET, server only, never NEXT_PUBLIC. Your FASHN API key.
FASHN_API_KEY=your-fashn-api-key
# FASHN model. 'tryon-max' is the maximum-quality model (4 credits/call at 2k
# quality); 'tryon-v1.6' is the 1-credit/call lightweight model. Quality tier is
# always the top setting — there is no standard tier.
FASHN_MODEL=tryon-max
# tryon-max output resolution: 1k | 2k | 4k. Ignored by tryon-v1.6.
FASHN_RESOLUTION=2k
# Fair-use render quota. Product defaults are 3/day and 30/month; override only
# for testing (e.g. raise while validating), then set them back.
RENDER_DAILY_LIMIT=3
RENDER_MONTHLY_LIMIT=30

# --- Plans (free vs paid) ---
# Free = 15 pieces, 0 try-ons — coded in @/lib/plan, not env. Paid unlocks the
# hand and a larger wardrobe. The paid piece cap is env so it can move freely.
PRO_PIECE_LIMIT=50
# TESTING allowlist: comma-separated user ids granted paid access regardless of
# their real status. Per-account, never global — only these ids are affected,
# everyone else follows their real subscription_status. Empty/unset = nobody
# overridden. Use it to test try-on on your own account without touching anyone
# else. (Replaces the old global PAID_OVERRIDE switch, which is now ignored.)
# PAID_OVERRIDE_UIDS=00000000-0000-0000-0000-000000000000,11111111-1111-1111-1111-111111111111

# --- Guest (pre-signup) flow ---
# Secret that authorises the scheduled purge of anonymous guest data. The purge
# route (/api/guest/purge, hit by Vercel Cron) refuses to run without it.
CRON_SECRET=set-a-long-random-string
# How long guest (pre-signup) data lives before the purge deletes it. Default 24.
GUEST_TTL_HOURS=24

# --- Phone verification ---
# 'stub' logs the code and accepts 000000. Dev only; throws in production.
PHONE_VERIFIER=stub

# --- Whop payments ---
# Server-only secrets — NEVER prefix these with NEXT_PUBLIC (that would ship them
# to the browser). Set them in Vercel's environment variables, not in code.
#   WHOP_API_KEY        — Whop app API key (used server-side to create checkout
#                         sessions carrying the buyer's BLOCK27 user id).
#   WHOP_WEBHOOK_SECRET — signing secret from Whop → Developer → Webhooks. The
#                         /api/webhooks/whop route refuses to run without it and
#                         rejects any request whose signature doesn't verify.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Whop app id (public). Required to build checkout sessions. Whop dashboard
# → your app. Defaults to this env in the SDK.
NEXT_PUBLIC_WHOP_APP_ID=
# Whop plan ids per tier. NOT secret (they appear in checkout URLs), so they are
# public — the client checkout embed and the webhook's plan->tier mapping both
# read them. Fill in once the plans exist in the Whop dashboard; until then the
# checkout UI hides those tiers and the webhook maps nothing.
NEXT_PUBLIC_WHOP_PLAN_PREMIUM=
NEXT_PUBLIC_WHOP_PLAN_PRO=
NEXT_PUBLIC_WHOP_PLAN_BOSS=
